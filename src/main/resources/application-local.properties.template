# --- Database MySQL locale ---
DB_USERNAME=root
DB_PASSWORD=changeme

# --- GitHub App + OAuth ---
# Dalla pagina della tua GitHub App (Settings > Developer settings > GitHub Apps)
github.app-id=123456
github.client-id=Iv1.xxxxxxxxxxxxxxxx
github.client-secret=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
github.webhook-secret=il-tuo-webhook-secret
# Private key in formato PKCS#8 (una sola riga, con \n al posto degli a-capo).
# Converti il .pem scaricato da GitHub (PKCS#1) con:
#   openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in app.private-key.pem -out app.pkcs8.pem
github.private-key=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
# URL pubblico del backend usato per il redirect OAuth.
github.callback-base-url=https://api.resumer.davidecascella.it
# App Link https a cui reindirizzare dopo il login: ci viaggia un codice usa-e-getta (?code=...),
# non il JWT. L'app intercetta questo URL (intent-filter autoVerify + assetlinks.json) e scambia
# il codice via POST /auth/exchange.
github.app-redirect-uri=https://api.resumer.davidecascella.it/app/callback
# Package dell'app Android. Legacy: non piu' usato.
github.app-package=it.davidecascella.githubresumer

# --- Anthropic (Claude) ---
anthropic.api-key=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- JWT di sessione (>= 32 caratteri) ---
app.jwt.secret=cambia-questo-con-un-segreto-lungo-almeno-32-caratteri

